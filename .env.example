# Siteform — copy to .env.local
# One Next.js app + one Postgres database. Do not provision per-customer Vercel/Neon projects.

# App
NEXT_PUBLIC_APP_NAME=Siteform
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000
AUTH_SECRET=replace-with-a-long-random-string

# Database (Neon pooled URL in production, local Postgres in docker-compose)
DATABASE_URL=postgres://siteform:siteform@localhost:5432/siteform

# LLM — without this key, extraction/generation fall back to deterministic heuristics
ANTHROPIC_API_KEY=

# Object storage — without this token, files are stored under .data/uploads
BLOB_READ_WRITE_TOKEN=

# Stripe — billing UI works without these; checkout is disabled until set
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=

# Email — generation-complete mail is skipped if unset
RESEND_API_KEY=
EMAIL_FROM=Siteform <noreply@localhost>
